{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "clonedigger",
          "version": "0.0.1.dev0",
          "informationUri": "http://clonedigger.sourceforge.net",
          "rules": [
            {
              "id": "duplicated-code",
              "name": "DuplicatedCode",
              "shortDescription": {
                "text": "Two runs of statements are copies of one another."
              },
              "fullDescription": {
                "text": "Found by anti-unification: the two copies have the same shape and differ only in a few names, constants or subtrees."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "duplicated-code",
          "level": "warning",
          "message": {
            "text": "Lines 46-54 are a copy of [examples/shipping.py:35-43](1), up to a difference of 4."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/shipping.py"
                },
                "region": {
                  "startLine": 46,
                  "endLine": 54
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "id": 1,
              "message": {
                "text": "the other copy"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/shipping.py"
                },
                "region": {
                  "startLine": 35,
                  "endLine": 43
                }
              }
            }
          ]
        },
        {
          "ruleId": "duplicated-code",
          "level": "warning",
          "message": {
            "text": "Lines 66-72 are a copy of [examples/shipping.py:57-63](1), up to a difference of 4."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/shipping.py"
                },
                "region": {
                  "startLine": 66,
                  "endLine": 72
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "id": 1,
              "message": {
                "text": "the other copy"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/shipping.py"
                },
                "region": {
                  "startLine": 57,
                  "endLine": 63
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
